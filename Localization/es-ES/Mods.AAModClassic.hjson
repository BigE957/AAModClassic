Keybinds: {
	Rifthotkey: Teletransporte a Base
	RiftReturnhotkey: Teletransporte de Vuelta
	AccessoryAbilityKey: Habilidad de Accesorio
	ArmorAbilityKey: Habilidad de Armadura

	Mods: {
		AAModClassic: {
			Keybinds: {
				InfinityHotKey.DisplayName: Chasquido
				Rifthotkey.DisplayName: Teletransporte a Base
				RiftReturnhotkey.DisplayName: Teletransporte de Vuelta
				AccessoryAbilityKey.DisplayName: Habilidad de Accesorio
