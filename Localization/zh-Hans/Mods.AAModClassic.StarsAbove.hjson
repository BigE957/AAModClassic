PromptDialogue: {
	MushroomMonarch: {
		Seen: {
			Asphodene: 哇！好大一朵蘑菇！而且它还会动……不过话说回来，在这个世界里这倒也不算太奇怪。
			Eridani: 这个世界的真菌确实奇特……最好不要小看这个敌人。
		}

		Defeat: {
			Asphodene: 它飞走了！这算我们赢了吧……？那我收下了。
			Eridani: 赤孢皇逃了。一场暂时的胜利，但总归是胜了。
		}
	}

	FeudalFungus: {
		Seen: {
			Asphodene: 发光蘑菇的皇室成员。还真有这种玩意儿。不过那些孢子看着可够危险的。
			Eridani: 红蘑菇王的对应者。我推测那些发光的孢子带有有害属性。
		}

		Defeat: {
			Asphodene: 它在逃走。一个发光的胆小鬼，不过至少它走了。
			Eridani: 真菌帝逃了。它还会回来的，不过我们好歹争取到了一些时间。
		}
	}

	GripsOfChaos: {
		Seen: {
			Asphodene: 两只恶心的巨手？谁搞出来的？它们看起来可不太友善。
			Eridani: 我能感觉到那对双爪散发着混沌能量。保持警惕。
		}

		Defeat: {
			Asphodene: 把手拿开！……好吧，我不开玩笑了。它们倒了。
			Eridani: 强大的对手，但我们靠着谨慎的走位取胜了。不过我怀疑这不会是最后一次见到这样的混沌之力。
		}
	}

	TruffleToad: {
		Seen: {
			Asphodene: 一只蘑菇青蛙。还会发光。泰拉瑞亚真是古怪，不过我开始觉得有点意思了。
			Eridani: 那只蟾蜍看起来相当暴躁。别被它小巧可爱的外表骗了。
		}

		Defeat: {
			Asphodene: 蟾蜍已经呱了。……我自己走，不用送。
			Eridani: 松露蟾蜍已不复存在。它的敏捷确实值得称道，但终究还是不够看。
		}
	}

	Broodmother: {
		Seen: {
			Asphodene: 一条真正的龙！好吧，这太酷了。……请别把我烧成焦炭。
			Eridani: 燎狱的育母炎龙。一只具有相当威力的火成爬行生物。她的烈焰将是致命的。
		}

		Defeat: {
			Asphodene: 育母炎龙倒了！我就知道我们能行。……关于身上的灼痕我就不多问了。
			Eridani: 育母炎龙已被击败。她的烈焰熄灭了。一个重大威胁被清除。
		}
	}

	HydraBody: {
		Seen: {
			Asphodene: 一个头、两个头……到底有几个头？！这有点失控了。
			Eridani: 九头渊蛇。每一个头都代表一个独立的威胁。逐一击破。
		}

		Defeat: {
			Asphodene: 刚才那是几个头来着？我数不过来了。至少它们全没了。
			Eridani: 九头渊蛇的头不再动弹了。一场漂亮的胜仗。
		}
	}

	SubzeroSerpent: {
		Seen: {
			Asphodene: 一条冰蛇？！美是很美，但多半要命。别靠太近。
			Eridani: 绝零冰蛇。它的霜焰吐息不是闹着玩的；尽量保持距离。
		}

		Defeat: {
			Asphodene: 那条蛇被冰镇了。我今天真是势不可挡。
			Eridani: 绝零冰蛇被征服了。冻原现在应该安全一点了。
		}
	}

	Djinn: {
		Seen: {
			Asphodene: 一个精灵！我能许三个愿望吗？不行？就只会撒沙和揍人吗？
			Eridani: 沙漠巨灵掌控着黄沙本身。别让他控制了战场。
		}

		Defeat: {
			Asphodene: 没许到愿望，但我们拿到了战利品。就当安慰奖收下了。
			Eridani: 巨灵回到了它的神灯之中。沙尘再次宁静。
		}
	}

	Sagittarius: {
		Seen: {
			Asphodene: 一匹会射激光的机器马。行吧，有什么不可以。这个世界总能让我大开眼界。
			Eridani: 一台风暴科学家的造物，但虚空的影响似乎已将其占据。谨慎行事。
		}

		Defeat: {
			Asphodene: 机器马倒地不起了。"大面积损坏"？是啊，废话。
			Eridani: 虚空人马已报废。现在跟一堆废铁没什么两样了。
		}
	}

	Anubis: {
		Seen: {
			Asphodene: 阿努比斯想试探试探我们。他说这次不会放水了。我们能行的吧……？
			Eridani: 阿努比斯，我们的盟友，现在是我们对练的对手。他想衡量我们的实力。别让他失望。
		}

		Defeat: {
			Asphodene: 他说我们干得不错。呼！刚才真紧张，不过看来他到底是叫得凶咬得轻。
			Eridani: 阿努比斯认可了我们的实力。看来无论前方有什么，我们都准备好了。
		}
	}

	Athena: {
		Seen: {
			Asphodene: 哦糟糕，揍了那些六翼天使可能不是个好主意……准备好打一架吧！
			Eridani: 看来我们在这儿擅自闯入，并未逃过对方的眼睛……现在我们要面对六翼天使的女王了。
		}

		Defeat: {
			Asphodene: 哈！给她点颜色看看！不敢再惹我们，算她识相。
			Eridani: 雅典娜罢手了。看来连她也对你的实力刮目相看。也许以后还有握手言和的余地。
		}
	}

	Greed: {
		Seen: {
			Asphodene: 一条浑身披着金子的巨型蠕虫。庸俗又致命。还真是不得了的组合。
			Eridani: 金食饕餮，镀金的暴食者。他囤积宝藏，憎恶入侵者。动机倒是不难猜。
		}

		Defeat: {
			Asphodene: 他钻回地里去了。看来我们暂时把他揍得够呛。
			Eridani: 金食饕餮缩回了岩层之中。那生物还活着，但我们也活着。
		}
	}

	Rajah: {
		Seen: {
			Asphodene: 哇哦，好大一只兔子！天哪他看起来超级生气。
			Eridani: 巨兔王公，突袭惩罚者。他在追求正义——但我们做了什么招惹了他的怒火？

			Murderer: {
				Asphodene: 他管你叫凶手。{0}，你干了什么啊？！
				Eridani: ……原来如此。这不是对练。他真心憎恨我们。他的愤怒并非没有理由。
			}
		}

		Defeat: {
			Asphodene: 他飞走了……用耳朵……当螺旋桨……这个世界总是令我惊叹。
			Eridani: 我们击败了突袭惩罚者，但他的怒火仍然令人不安。

			Murderer: {
				Asphodene: 他走了，但他发誓要复仇。也许我们该反思一下自己的所作所为了……
				Eridani: 他眼中带着憎恨撤退了。这事还没完。我们还会再面对他的。
			}
		}
	}

	ForsakenAnubis: {
		Seen: {
			Asphodene: 这家伙还真有脸说我们没准备好。他的新形态拦不住我们！让他见识见识！
			Eridani: 逝落的断罪师降临。他在试探我们是否准备好面对那些被封印的真相。向他证明吧。
		}

		Defeat: {
			Asphodene: 你表现得确实很棒！刚才那场对决真是精彩。去看看他想说什么。
			Eridani: 一场当之无愧的胜利。开个战略会议确实是明智之举。我们去跟他谈谈。
		}
	}

	AthenaA: {
		Seen: {
			Asphodene: 雅典娜还没完？！她这是要全力打"最后一场"？那我们也只能奉陪了！
			Eridani: 雅典娜决心不再输第二次……这次她不会像上次那么好对付了。保持警惕。就连风都在与我们为敌。
		}

		Defeat: {
			Asphodene: 真是只暴脾气的鹰身女妖！不过她提到了黑暗力量在觉醒……不妙。我们得多加小心了。
			Eridani: 雅典娜警告说混沌之力正在蠢蠢欲动。她口中的"他"会是谁？
		}
	}

	GreedA: {
		Seen: {
			Asphodene: 金食饕餮又回来了，还强了不止一点半点！不过我们的命可不是谁想拿就能拿的！
			Eridani: 金食饕餮 鎏金万蟲王。暴食者已长成。他要吞噬我们的性命。
		}

		Defeat: {
			Asphodene: 它又逃了。还在气头上，不过至少现在消停了。
			Eridani: 万蟲王逃了。金食饕餮从不真正死去；它只是蛰伏。
		}
	}

	EquinoxWorms: {
		Seen: {
			Asphodene: 昼夜双虫……他们说过这将是一场考验。来吧。
			Eridani: 启明虫与夜行虫。它们以一场力量试炼向我等致敬。不要辜负了这份心意。
		}

		Defeat: {
			Asphodene: 它们在消散。看来我们终究是通过了它们的考验。
			Eridani: 昼夜双虫化为虚无。看来我们被判定为配得上这力量。
		}
	}

	SistersOfDiscord: {
		Seen: {
			Asphodene: 艾希和遥香。她们听说过我们了。这下可能真结了梁子了。
			Eridani: 混沌姐妹。烈火与钢铁，她们想为过去的某次冒犯复仇。
		}

		Defeat: {
			Asphodene: 她们撤了。"总得有人去告诉老爸"？她们的老爸是谁？我还真有点好奇了。
			Eridani: 艾希和遥香撤了。她们低估了我们的实力。不过她们的父亲倒是值得担心的角色。
		}
	}

	YamataBody: {
		Seen: {
			Asphodene: 七个头。而且它还叫个不停。好极了。真是好极了。
			Eridani: 八歧大蛇，惊惧梦魇。自负如山，剧毒如海。不惜一切代价避开它的吐息。
		}

		Defeat: {
			NotExpert: {
				Asphodene: 它倒了，但已经在吹牛了。"我放水了！"对对对，你放水了。
				Eridani: 八歧大蛇的身躯倒下了，但事情不太对劲。我想他说自己放了水可能是当真的……
			}

			Expert: {
				Asphodene: 哈！那条九头蛇也没那么难嘛。……等等，有点不对劲。
				Eridani: 八歧大蛇的躯体崩塌了，然而……空气凝固了。我检测到一股有害的能量激增。做好准备。
			}
		}
	}

	YamataABody: {
		Seen: {
			Asphodene: 哦天！七个头还不够？！现在他更大了也更怒了。我们麻烦大了。
			Eridani: 原来这才是八歧大蛇力量的完全觉醒。这是他的真身——不要惧怕。
		}

		Defeat: {
			Asphodene: 他撤退了，还是气冲冲的。不过还真有脸说我们作弊啊。算了，反正是我们赢了。
			Eridani: 八歧大蛇在暴怒中逃遁。他还会回来，但今天我们已经证明了自己。
		}
	}

	Akuma: {
		Seen: {
			Asphodene: 一条老管我们叫"小子"的火焰飞龙。没礼貌又致命。老套路了。
			Eridani: 邪鬼巨龙，凶煞恶魔。正面强攻，毫无花招。这里没有诡计可言。
		}

		Defeat: {
			NotExpert: {
				Asphodene: 他化成余烬消散了。"练好了再来。"还挺谦虚的嘛，你？
				Eridani: 邪鬼巨龙的灵魂仍在。凶煞恶魔并没有真正死去——只是暂时消散。
			}

			Expert: {
				Asphodene: 他在溶解……我们赢了？等等，好像又有什么在发生……
				Eridani: 邪鬼巨龙的身形散开了，但他的精魂徘徊不散。不对，等等……我感觉到一股正在积蓄的力量。
			}
		}
	}

	AkumaA: {
		Seen: {
			Asphodene: 还没完？！那条飞龙变得超——烫了。我们还真是煽风点火了啊……！这下糟了。
			Eridani: 这一定就是邪鬼巨龙真正的觉醒之力。气温正在剧烈攀升——不要停止移动。
		}

		Defeat: {
			Asphodene: 终于！他承认我们堂堂正正赢了。可算是等到这句话了。
			Eridani: 邪鬼巨龙认输了。他的语气中流露出一丝敬意。一种不情愿的敬意。
		}
	}

	Zero: {
		Seen: {
			Asphodene: 一台飘在空中的机器，周围还有武器环绕。它在用代码说话。让人头皮发麻。
			Eridani: 零械单元。末日构造体。它的武器将发动无情的攻击。快找掩体！
		}

		Defeat: {
			NotExpert: {
				Asphodene: 零械倒了。不过它最后好像想做什么来着……也许它故障了算我们走运。
				Eridani: 构造体倒下了，但它的"末日协议"让我深感不安。它未能启动那协议，我们可能算走运。
			}
		}
	}

	ZeroProtocol: {
		Seen: {
			Asphodene: 哇！它把自己的物理身体给扔了？！这"末日协议"可不是开玩笑的！我们现在是在跟一个活的故障打。
			Eridani: 抛弃了零械单元的躯壳。现在我们要面对的是另一种存在了。它变得灵活多了。别让它抓住你！
		}

		Defeat: {
			Asphodene: 一个求救信号？那玩意儿能是打给谁求救的？！还有那个不祥的裂隙我也不太喜欢……
			Eridani: 让那台机器发出了求救信号，后果可能是灾难性的。我相信虚空之主可能已在向我们逼近。
		}
	}

	SupremeRajah: {
		Seen: {
			Asphodene: 又是这家伙？！这升级也太夸张了吧！但我们可不能栽在这只兔子手里。
			Eridani: 无辜者的保护者。这是他真正的力量。这次我们没那么容易赢了。

			Murderer: {
				Asphodene: 他更生气了。又管我们叫"凶手"。我们真是摊上大事了，对吧？
				Eridani: 没有宽恕。只有复仇。在正义得到伸张之前，他不会罢休。
			}
		}

		Defeat: {
			Asphodene: 他停手了？哇，他想让我们接替他的位置？{0}，他是认真的。
			Eridani: 守护者将职责交到了我们手中。"成为无辜者可以仰望的人。"一份沉重的责任。
		}
	}

	Shen: {
		Seen: {
			Asphodene: 那是……八歧大蛇和邪鬼巨龙的合体。我们完了……
			Eridani: 上神应龙，冥昧末日的预言者。对我们能力的真正考验。
		}

		Defeat: {
			Expert: {
				Asphodene: 呼……真是场硬仗！等一下……怎么回事？
				Eridani: 预言者倒下了。不，等等。还没结束吧？我感觉到了残留的能量。
			}

			NotExpert: {
				Asphodene: 呼……真是场硬仗！等等……"真正的力量"？你是说刚才那还不是他的全力？！
				Eridani: 想到那条龙还没拿出全部实力……要是他放开手脚使出全力，我还真不敢想象会有多可怕。
			}
		}
	}

	ShenA: {
		Seen: {
			Asphodene: 那还不是他们的最终形态？！这家伙真是没完没了了！
			Eridani: 他说得对。我们本该预料到的。考验仍在继续。
		}

		Defeat: {
			Asphodene: 他在分裂！而且他们俩在互相埋怨。经典的反派合作戏码。
			Eridani: 上神应龙的融合瓦解了。"你们还会再次面对我们的怒火。"一个无尽的循环。
		}
	}

	InfinityZero: {
		Seen: {
			Asphodene: 好大一台机器……这就是那个求救信号叫来的？！而且它锁定了我们。这下可真麻烦了……
			Eridani: 一台拥有巨大威力的机械构造体。求救信号一定是发给它的……准备好。
		}

		Defeat: {
			Asphodene: 刚才说话的是谁？！"下次不会再手下留情"？那人不可能比这台机械怪兽还强吧，对吧……？
			Eridani: 它就那样轻易地离开了，我们真是走运……它的力量超出了任何指标。"下次，我不会再手下留情。"对未来的一个警告。
		}
	}

	SoulOfCthulhu: {
		Seen: {
			Asphodene: 一个长着脸的船舵？而且我听到了低语……"离开"……让人心里发毛。
			Eridani: 克苏鲁之魂。古老、邪恶、而且现在醒了。我们必须万分谨慎。
		}

		Defeat: {
			Asphodene: 它一边诅咒我们一边炸了。"以阿撒托斯之名！"……我们该担心吗？
			Eridani: 克苏鲁的怒火已耗尽。但它的诅咒不可轻视。这可能还没完……更强大的势力或许还隐藏在背后。
		}
	}
}
