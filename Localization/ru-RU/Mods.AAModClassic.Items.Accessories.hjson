AleisterBook: {
	DisplayName: Книга Алистера
	Tooltip:
		'''
		Легендарная книга Мега Териона
		Увеличивает урон призывателя на 10%
		Увеличивает максимальное количество миньонов на 2
		Может, ты сможешь сделать её сильнее?..
		На обложке есть записка: 
		Мне нужны более мощные души, *****,*********,**********
		'''
}

TheBookOfTheLaw: {
	DisplayName: Книга закона
	Tooltip:
		'''
		Легендарная книга Мега Териона
		Увеличивает урон призывателя на 30%
		Увеличивает максимальное количество миньонов на 2
		Включает в себя эффекты от всех использованных для создания компонентов

		'''
}

