CoreSpawn: Биомитовое ядро оживает!

SistersOfDiscord: {
	Spawn: {
		1: Ну приветик, какой сюрприз увидеть ТЕБЯ здесь~!

		2: {
			None: О да, я МНОГО о тебе слыхала, малец... ты такой кипиш в этих краях устроил...
			Broodmother: О да, я МНОГО о тебе слыхала, малец... это ведь ты, мелочь теплокровная, отделал мою мать!..
		}

		3: {
			Both: И мою...
			Hydra: ...а ещё ты ранил мою мать...
			None: Ты довольно надоедливый, знаешь ли...
		}

		4: Так что теперь!.. Хех...
		5: Мы тебе устроим, ты будешь ВИЗЖАТЬ КАК НЕ В СЕБЯ! Давай, Хаки, поджарим эту мелочь теплокровную!~
		6: Не зови меня Хаки...никогда.
	}

	AsheDowned: АЙ!.. БОЛЬНО, ИРОД!
	HarukaDowned: Ргх!.. Ай...

	Defeat: {
		First: {
			1: Видишь, Эш? Я же говорила - это глупая затея, но ты КАК ОБЫЧНО не слушала...

			2: {
				Front: "Закройся! Я думала, что если мы ВДВОЁМ нападём на "
				Back: ", то снесём его всухую!"
			}

			3: Неважно...я иду домой. Ведь кто-то ДОЛЖЕН рассказать отцу об этом малыше.
			4: Хмпф!.. Оке-е-ей! Делай, что хочешь! Тогда я вернусь в Инферно!
		}

		1: РРРРРРРРГХ! СКОЛЬКО МОЖНО!!!
		2: На кой я вообще хожу с тобой?.. Мне, честно, уже хочется просто оставлять тебя сражаться с ними одну.
		3: Ргх!.. Закройся уже!..
	}
}

Akuma: {
	Attacks: {
		Skyfall: {
			A: Эй, дитя! Небеса падают, берегись!
			B: Дождь из огня и ярости!
		}

		BigShot: {
			A: Эй, дитя! Берегись!
			B: На подлёте!
		}

		SeekingFlames: {
			A: Предстань перед пламенем отчаяния, дитя!
			B: Пригнись, дитя!
		}
	}

	WaterHit: Вода?! АКХ!.. ЗАДЫХАЮСЬ!

	Despawn: {
		Night: *Зево-о-о-о-о-ок*. Выдохся я, дитя, давай как-нибудь потом. Например, завтра.
		Escape: Я думал вы, террарийцы, можете сражаться всерьёз. Видимо нет.
	}

	Defeat: {
		Status: Вулканы в Инферно наконец утихают...
		NotExpert: Хмпф...а ты можешь дать жару, дитя, жаль только, что запал твой слаб. Возвращайся, когда станешь лучше прежнего себя.
	}

	Transition: {
		1: Хех...
		2: Знаешь, дитя...
		3: раздувая пламя, ты не потушишь его...
		4: Акума пробуждается!
		5: А ЛИШЬ УСИЛИШЬ!
		6: Воздух вокруг вас стремительно нагревается...
	}

	Awakened: {
		AsheAppear: {
			First: {
				Ashe: Эй! Лапы свои от папы убрал!
				Akuma: Умница!..
			}

			Ashe: Так точно, папочка!..
			Akuma: Эш? Помоги своему старому папке разобраться с этим мальцом!
		}

		Defeat: {
			Repeat: Хех, а в этот раз ты пылал сильнее, дитя. Впечатляет. Вот. Забирай свой приз.
			First: ГРАХ!.. КАК!? КАК Я УМУДРИЛСЯ ПРОИГРАТЬ КАКОМУ-ТО ТЕРРАРИЙЦУ?! Хмпф...ладно, дитя, твоя взяла, всё честно. Забирай свою награду.
			Cheat: Браво, читерюга. А теперь иди и сразись со мной в экспертном режиме как настоящий мужик.
		}

		DayReset: Ночь тебя не спасёт, дитя! День имеет тенденцию начинаться заново!
		Kill: Ты сгорел, дитя.
	}

	#Unused
	Akuma6: Духи вулкана! Помогите мне раздавить это дитя!
	Akuma9: Солнце пылает, и в округе ни клочка тени, дитя!
	Akuma10: Становится жарковато, а?
	AkumaA5: Ещё держишься? А огонь тебе по душе! Это-то мне в тебе и нравится, дитя!
	AkumaA6: Что?! Как ты продержался так долго?! Ты, такой мелкий... Я отказываюсь вновь падать от рук террарийца! Имей в виду!
	AkumaA7: АКХ!.. ВОДА! НЕНАВИЖУ ВОДУ!!!
	AkumaA13: Небеса падают вновь! Будь бдителен!
	AkumaA14: Пламя ярости обрушивается вновь!
	AkumaA15: Ты недооцениваешь артиллерию дракона, дитя!
	AkumaA16: Пламя никогда не сдаётся, дитя!
	AkumaA17: Пригнись, дитя! Вулкан извергается!
	AkumaA18: НА ПОДЛЁТЕ!
	AkumaA19: Эй, дитя, фейерверки любишь? Нет? Тем хуже!
	AkumaA20: А вот и грандиозный финал, дитя!
	AkumaA21: Солнце не погаснет до конца дня, дитя!
	AkumaA22: Предстань перед яростью солнца!
	AkumaAAshe1: Папа, НЕТ! ЭЙ! ТЫ! В следующий раз я отжарю тебя как следует..!
	AkumaAAshe2: АЙ, ублюдок!.. С меня хватит!
}

Anubis: {
	Kill: ХАХ! Обставили те--, то есть, обсыпали тебя.

	Intro: {
		1: {
			Singleplayer: Ну что, друг мой. Мы на месте.
			Multiplayer: Ну что, ребят. Мы на месте.
		}

		2: Я надеюсь, ты готов к поистине настоящему бою.
		3: И учти - я сейчас в своей наилучшей форме.
		4: Приготовься. Я без колебаний всыплю тебе по первое число!
		5: Погнали!
		Rematch: Реванш, значится? Нет проблем, будет весело!
	}

	Combat: {
		PumpkinThrow: *ВЖУХ*
		Runeblast: Аккуратней! Снаряды ранить могут.
		Summons: Позволь-ка мне прихватить пару друзей.
		ScepterThrow: Лови-ка!
		BlockCrush: Смачно, а?
	}

	Transition: {
		1: ...хрг...
		2: ...ладненько.
		3: Думается мне...пора.
		4: Больше никаких поддавков.
		5: Если уж ты собрался бросить вызов скверным силам этого мира...
		6: То я должен убедиться, что ты готов, ибо если нет...
		7: ...Некоторым вещам будет лучше оставаться сокрытыми от глаз твоих. Ради твоего же блага.
	}

	Forsaken: {
		Warning: На этот раз обойдёмся без предупреждений.
		Kill: ...Прости, но ты пока не готов.
		Defeat: ...Ты справился, друг мой. Нам с тобой надо разработать план на будущее. Коль будешь готов - подойди ко мне, поболтаем.
	}
}

Athena: {
	Intro: {
		First: {
			1: Хмпф..!

			2: {
				Singleplayer: Ты! Землеходец!
				Multiplayer: Вы! Землеходцы!
			}

			3: Мне тут серафимы мои напели, что ты их обижаешь! Как ты смеешь?!
			4: Ты... Я сейчас проучу тебя, мелочь сопливая!
			5: Молись!
		}

		PreAthenaA: {
			1: ...Итак. Опять ты.
			2: Время пришло... Я отвоюю свою честь!..
			3: Молись!
		}

		Repeat: {
			1: *вздох*...
			2: Давай просто покончим с этим. Я не хочу маяться тут целый день.
		}
	}

	AwakenedSummon: Уничтожить один из моих артефактов...? Вы, землеходцы, просто не перестаёте меня раздражать!
	Kill: И не приближайся больше, идиот.
	Defeat: ОЙ! Ладно, ладно!.. Я оставлю тебя в покое! М-да, а ты всё не унимаешься, а?

	Transition: {
		1: ...хах...хах...
		2: ...я... проиграла?
		3: Нет.
		4: Я так просто не сдамся.
		5: Есть у нашего народа одна поговорка, землеходец.
		6: В сиянии рассветном...
		7: Во тьме ночной...
		8: В сражении заветном...
		9: ВАРИАН ВСЕГДА ДАЁТ ПОСЛЕДНИЙ БОЙ!
		Repeat: Хватит дурачиться! Шторм надвигается - он идёт за тобой!
	}

	Awakened: {
		Kill: И не приближайся больше, идиот.

		Defeat: {
			1: ...ПОЧЕМУ?!
			2: ...Почему я не могу победить?!

			3: {
				Singleplayer: ...Ты ещё услышишь обо мне, землеходец...
				Multiplayer: ...Вы ещё услышите обо мне, землеходцы...
			}

			4: Да, я верну свою честь... рано или поздно.
			5: ...а до тех пор - гляди в оба.
			6: В последнее время силы скверного хаоса начали пробуждаться ото сна.
			7: Надеюсь, как бы ОН не вернулся...
			8: Береги себя.
			Repeat: ОЙ! Ладно, ладно!.. Я оставлю тебя в покое! М-да, а ты всё не унимаешься, а?
		}
	}
}

SeraphHerald1: ЭЙ! ЗЕМЛЕХОДЕЦ! ДА, ТЫ, ТУПАЯ ОБЕЗЬЯНА!
SeraphHerald2: Королева Афина приказывает тебе снова посетить Акрополь, живо!
SeraphHerald3: Она требует реванша, и на этот раз так легко тебе не дастся!
SeraphHerald4: Как там у вас говорят - «ни пуха, ни пера»!... А ведь у вас реально «ни ПУХА, ни ПЕРА», ах-ха-ха, вы такие никчёмные!
SeraphHerald5: Ладно, до скорого, соплежуй!
SeraphHerald6: Ах да, ещё э-, тот жалкий червь-клептоман захотел получить повторных люлей, как я понял. Посети и его на досуге

EquinoxDialogue: {
	GravAltar: Глубоко в пещерах этого мира обитает король червей - страж земли, созданный, чтобы даровать нам жизнь.
	StarAltar: Высоко в облаках правит Королева Серафимов - страж небес, откуда за нами наблюдают создатели.
	WormAltar: Идол встаёт в паз, но ничего не происходит.
	WormAltarOK: Идол оживает, озаряясь блеском и возвращая свой первозданный цвет.
	s: heroes: герои
	heroes: герои
	WormSpawn1: Похоже, кто-то вновь собрал наш идол, дорогая Вестница дня.
	WormSpawn2: Похоже на то, малыш
	WormSpawn3: ", ты произвёл на нас огромное впечатление"
	WormSpawn4: Может, он тот, кого мы так долго искали..?
	WormSpawn5: ...возможно.
	WormSpawn6: Юное дитя
	WormSpawn7: . Мы бы хотели устроить тебе последнее испытание.
	WormSpawn8: Испытание силы в битве с нами.
	WormSpawn9: Когда будешь готов, позови нас, держа в руках статую червя.
	WormSpawn10: Мы сможем найти тебя по маякам, которые ты активировал.
	WormSpawn11: Однако...
	WormSpawn12: "Не думай, что победа достанется тебе так легко, "
}

Greed: {
