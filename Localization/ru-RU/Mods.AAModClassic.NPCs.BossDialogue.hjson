Rajah: {
	#Anticheat Unused
	Cheat: ПРАВОСУДИЕ НЕ ОБМАНУТЬ
	Kill: Правосудие свершилось...
	Despawn: Трус.
	Defeat.Murderer: На этот раз победа твоя, маньячелло...но не думай, что я прощу тебе все совершённые тобой убийства...

	Awakened: {
		PowerUp: Раджа вспыхивает яростной энергией во время атаки, усиливая свою защиту

		LastStand: {
			Singleplayer: {
				Murderer: МЫ ЕЩЁ НЕ ЗАКОНЧИЛИ, МЯНЬЯЧЕЛЛО! НАСТОЯЩИЕ СОПЕРНИКИ ВСЕГДА СРАЖАЮТСЯ ДО КОНЦА!
				Normal: МЫ ЕЩЁ НЕ ЗАКОНЧИЛИ, ТЕРРАРИЕЦ! НАСТОЯЩИЕ СОПЕРНИКИ ВСЕГДА СРАЖАЮТСЯ ДО КОНЦА!
				Repeat: МЫ ЕЩЁ НЕ ЗАКОНЧИЛИ, {0}! НАСТОЯЩИЕ СОПЕРНИКИ ВСЕГДА СРАЖАЮТСЯ ДО КОНЦА!
			}

			Multiplayer: {
				Murderer: ЭТО ЕЩЁ НЕ КОНЕЦ, МЯНЬЯЧЕЛЛЫ! НАСТОЯЩИЕ СОПЕРНИКИ ВСЕГДА СРАЖАЮТСЯ ДО КОНЦА!
				Normal: ЭТО ЕЩЁ НЕ КОНЕЦ, ТЕРРАРИЙЦЫ! НАСТОЯЩИЕ СОПЕРНИКИ ВСЕГДА СРАЖАЮТСЯ ДО КОНЦА!
			}
		}

		Kill: Упор лёжа, террариец.

		Defeat: {
			First: {
				1: Грх...
				2: ...значит...
				3: Даже будучи на пике своих возможностей...
				4: ...я всё ещё не могу одолеть тебя.
				5: ...Террариец...как думаешь...
				6: Может это знак?... Знак того, что моё время как защитника...
				7: ...подошло к концу. Мне кажется, пора передать эстафету.
				8: ...Я прощу тебе каждого убитого тобой кролика, но взамен...Я хочу, чтобы ты занял моё место...
				9: ...стал для них чемпионом - их защитником.
				10: Я желаю лишь лучшего для созданий этого мира...и раз уж ты сильнее меня...

				11: {
					Singleplayer: То кто ещё справится с этим лучше тебя, {0}?
					Multiplayer: То кто ещё справится с этим лучше вас, террарийцы?
				}

				12: Ты можешь стать тем, на чьё плечо невинные смогут склонить головы в трудный час.
				13: Подумай об этом.
				14: И если ты когда-нибудь захочешь повторить наш спарринг... используй одну из тех особых морковок. Я буду рад вернуть свою честь.
				15: ...Увидимся, малыш.
				Status: Речь Кролика-Раджи согревает ваше сердце. У вас больше нет желания причинять вред кроликам. Не подведите его.
			}

			Repeat: {
				Singleplayer: Молодцом сражался, {0}. Забирай свою награду.
				Multiplayer: Молодцом сражались, террарийцы. Забирайте свою награду.
			}
		}
	}
}

