Functional: {
	ChaosCrucible: {
		DisplayName: Горнило хаоса
		Tooltip: Даже хаос требует твёрдой руки и исполинской кузни для работы
	}

	TruePaladinsSmeltery: {
		DisplayName: Истинная плавильня паладина
		Tooltip:
			'''
			Кузня высшего порядка, предназначенная лишь для самых достойных кузнецов
			Выполняет функции большинства необходимых станций изготовления
			'''
	}

	HaphestusForge: {
		DisplayName: Кузня Гефеста
		Tooltip:
			'''
			*Хлопает по верху кузни* «Эта крошка вмещает в себя уйму станций!»
			Выполняет функции адской кузни, наковальни из адского камня, алхимического стола, демонического алтаря, мастерской изобретателя, а также стола и стула
			'''
	}

