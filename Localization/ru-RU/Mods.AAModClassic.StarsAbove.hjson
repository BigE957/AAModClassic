PromptDialogue: {
	MushroomMonarch: {
		Seen: {
			Asphodene: Ух ты! Огромный гриб! И он движется... Ну, для этого мира не так уж и странно.
			Eridani: Грибы этого мира поистине необычны... Не стоит недооценивать этого врага.
		}

		Defeat: {
			Asphodene: Улетает! Значит, мы победили?... Сойдёт.
			Eridani: Монарх сбежал. Временная победа, но всё же победа.
		}
	}

	FeudalFungus: {
		Seen: {
			Asphodene: Светящийся грибной король. Ну конечно. Только споры у него выглядят опасно.
			Eridani: Двойник красного монарха. Подозреваю, эти люминесцентные споры несут вредоносные свойства.
		}

		Defeat: {
			Asphodene: Отступает. Светящийся трус, но хотя бы убрался.
			Eridani: Грибной феодал сбежал. Он вернётся, но мы выиграли время.
		}
	}

	GripsOfChaos: {
		Seen: {
			Asphodene: Две гигантские мерзкие руки? Кто их сделал? Выглядят недружелюбно.
			Eridani: Я чувствую хаотическую энергию, исходящую от этих Дланей. Будь начеку.
		}

		Defeat: {
			Asphodene: Руки прочь! ...Ладно, молчу. Они повержены.
			Eridani: Грозный враг, но мы одолели его благодаря осторожному позиционированию. Впрочем, сомневаюсь, что мы в последний раз видим подобные хаотические силы.
		}
	}

	TruffleToad: {
		Seen: {
			Asphodene: Грибная лягушка. Светится. Террария - чудной мир, но мне начинает нравиться.
			Eridani: Эта жаба кажется взволнованной. Пусть её маленький и миловидный вид не обманывает тебя.
		}

		Defeat: {
			Asphodene: Жабка квакнулась. ...Я, пожалуй, пойду.
			Eridani: Трюфельной жабы больше нет. Её ловкость была примечательна, но недостаточна.
		}
	}

	Broodmother: {
		Seen: {
			Asphodene: Настоящий дракон! Ого, это круто. ...Пожалуйста, не испепели меня дотла.
			Eridani: Матерь выводка Инферно. Пиро-рептилия с огромной силой. Её пламя смертельно.
		}

		Defeat: {
			Asphodene: Матерь выводка пала! Я знала, что мы справимся. ...Про ожоги спрашивать не буду.
			Eridani: Матерь выводка повержена. Её пламя угасло. Значительная угроза нейтрализована.
		}
	}

	HydraBody: {
		Seen: {
			Asphodene: Одна голова, вторая... сколько их вообще?! Это выходит из-под контроля.
			Eridani: Гидра. Каждая голова - отдельная угроза. Сосредоточься на одной за раз.
		}

		Defeat: {
			Asphodene: Сколько там было голов? Я сбилась со счёта. По крайней мере, все исчезли.
			Eridani: Головы Гидры перестали двигаться. Заслуженная победа.
		}
	}

	SubzeroSerpent: {
		Seen: {
			Asphodene: Морозная змея?! Красивая, но наверняка смертоносная. Близко не подходи.
			Eridani: Морозная змея. Её ледяное пламя - не шутка. При возможности держись на расстоянии.
		}

		Defeat: {
			Asphodene: Разморозили змейку. Я сегодня в ударе.
			Eridani: Морозная змея повержена. Теперь снега станут немного безопаснее для исследования.
		}
	}

	Djinn: {
		Seen: {
			Asphodene: Джинн! Можно мне три желания? Нет? Только песок и тумаки?
			Eridani: Пустынный Джинн повелевает самими песками. Не дай ему контролировать поле боя.
		}

		Defeat: {
			Asphodene: Без желаний, но с добычей. Приму как утешительный приз.
			Eridani: Джинн возвращается в свою лампу. Пески снова спокойны.
		}
	}

	Sagittarius: {
		Seen: {
			Asphodene: Робо-конь, стреляющий лазерами. Ну да, почему бы и нет. Этот мир не перестаёт удивлять.
			Eridani: Конструкция Фульгурийцев, но чувствуется влияние Пустоты. Будь осторожен.
		}

		Defeat: {
			Asphodene: Робо-конь повержен. «Обширные повреждения»? Да, без шуток.
			Eridani: Сагиттариус выведен из строя. Теперь это груда металлолома.
		}
	}

	Anubis: {
		Seen: {
			Asphodene: Анубис хочет испытать нас. Сказал, что не не собирается поддаваться. Надеюсь, мы готовы...
			Eridani: Анубис, наш союзник, теперь спарринг-партнёр. Он хочет проверить нашу силу. Не разочаруй его.
		}

		Defeat: {
			Asphodene: Говорит, мы справились. Фух! Напряжённо, но, видно, всё лаем кончилось, не укусил.
			Eridani: Анубис признаёт нашу силу. Похоже, мы готовы к тому, что ждёт нас впереди.
		}
	}

	Athena: {
		Seen: {
			Asphodene: Ох, чёрт, может, зря мы этих серафимов поколотили... Готовься к битве!
			Eridani: Похоже, наше вторжение не осталось незамеченным... Теперь нам противостоит Королева Серафимов.
		}

		Defeat: {
			Asphodene: Ха! Мы её уделали! Оставить нас в покое - верное решение.
			Eridani: Афина смягчилась. Похоже, даже она впечатлена вашей силой. Возможно, нам удалось загладить вину.
		}
	}

	Greed: {
		Seen: {
			Asphodene: Гигантский червь, покрытый золотом. Безвкусно И смертоносно. Гремучая смесь.
			Eridani: Алчность, Позолоченный Обжора. Копит сокровища и ненавидит незваных гостей. Предсказуемая мотивация.
		}

		Defeat: {
			Asphodene: Уполз обратно в землю. На сегодня, видимо, хватит.
			Eridani: Алчность скрылся в камне. Тварь жива, но и мы тоже.
		}
	}

	Rajah: {
		Seen: {
			Asphodene: Ого, вот это кролище! И он ОЧЕНЬ зол.
			Eridani: Кролик-Раджа, Прыгучий Каратель. Ищет справедливости. Но что мы сделали, чтобы вызвать его гнев?

			Murderer: {
				Asphodene: Он назвал тебя маньячеллой. {0}, что ты НАДЕЛАЛ?
				Eridani: ...Понятно. Это не спарринг. Он искренне нас презирает. И его гнев не беспричинный.
			}
		}

		Defeat: {
			Asphodene: Он улетает... На ушах... Как на пропеллерах... Этот мир не перестаёт впечатлять.
			Eridani: Мы одолели Прыгучего Карателя, но всё же его гнев был весьма тревожащим.

			Murderer: {
				Asphodene: Он убрался, но поклялся отомстить. Может, нам стоит пересмотреть свои поступки...
				Eridani: Он отступает с ненавистью в глазах. Это не конец. Мы ещё встретимся.
			}
		}
	}

	ForsakenAnubis: {
		Seen: {
			Asphodene: У этого парня хватает наглости думать, что мы не готовы. Его новая форма нас не остановит! Давай покажем ему!
			Eridani: Отвергнутый Судья восстаёт. Он проверяет, готовы ли мы к тому, что сокрыто от наших глаз. Докажем же ему, что мы готовы.
		}

		Defeat: {
			Asphodene: Ты и правда хорошо справился! Вот это была схватка. Посмотрим, что он хочет.
			Eridani: Заслуженная победа. Обсудить стратегию было бы мудро. Пойдём поговорим с ним.
		}
	}

	AthenaA: {
		Seen: {
			Asphodene: Афина не закончила?! Она сражается в полную силу ради «последнего боя»? Тогда и мы сделаем то же самое!
			Eridani: Афина полна решимости не проиграть снова... Так легко она не падёт. Будь настороже. Сами ветра против нас.
		}

		Defeat: {
			Asphodene: Вот так злобная гарпия! Но она упомянула скверные силы, пробуждающиеся... зловеще. Придётся глядеть в оба.
			Eridani: Афина предупреждает о движении хаотических сил. Кто этот «он», о котором она говорила?
		}
	}

	GreedA: {
		Seen: {
			Asphodene: Алчность вернулся и стал куда сильнее! Только вот наши жизни не для того, чтобы их забирали!
			Eridani: Король червей, Алчность. Обжора разросся. Он угрожает поглотить наши жизни.
		}

		Defeat: {
			Asphodene: Опять сбежал. Всё ещё злой, но хотя бы убрался.
			Eridani: Король червей ускользнул. Алчность никогда не умирает; лишь впадает в спячку.
		}
	}

	EquinoxWorms: {
		Seen: {
			Asphodene: Черви Равноденствия... они говорили, это будет для нас испытанием. Поехали.
			Eridani: Вестница дня и Ползун ночи. Они оказывают нам честь испытанием силы. Не разочаруем их.
		}

		Defeat: {
			Asphodene: Они растворяются. Похоже, мы прошли их тест.
			Eridani: Черви Равноденствия исчезают. Нас сочли достойными.
		}
	}

	SistersOfDiscord: {
		Seen: {
			Asphodene: Эш и Харука. Они о нас слышали. Может, это личное.
			Eridani: Сёстры Раздора. Огонь и сталь, и они хотят мести за какую-то былую обиду.
		}

		Defeat: {
			Asphodene: Они отступают. «Кто-то ДОЛЖЕН рассказать отцу»? Кто их отец? Мне уже любопытно.
			Eridani: Эш и Харука отступают. Они недооценили наши возможности. Хотя об их отце, возможно, стоит беспокоиться.
		}
	}

	YamataBody: {
		Seen: {
			Asphodene: Семь голов. И не перестаёт вопить. Отлично. Просто отлично.
			Eridani: Ямата, Ужасающий Кошмар. Гигантское эго, гигантский яд. Избегай его дыхания любой ценой.
		}

		Defeat: {
			NotExpert: {
				Asphodene: Он пал, но уже хвастается. «Я поддался!» Ну конечно.
				Eridani: Тело Яматы пало, но что-то не так. Думаю, он серьёзен насчёт того, что сдерживался...
			}

			Expert: {
				Asphodene: Ха! Эта гидра была не так уж страшна. ...Погоди, что-то неладно.
				Eridani: Форма Яматы разрушается, и всё же... воздух застыл. Я чувствую пагубный выброс силы. Приготовься.
			}
		}
	}

	YamataABody: {
		Seen: {
			Asphodene: Боже! Семи голов было мало?! Теперь он ещё больше и злее. У нас проблемы.
			Eridani: Вот, значит, какова истинная, пробуждённая сила Яматы. Это его настоящая форма – не дрогни.
		}

		Defeat: {
			Asphodene: Отступает, всё ещё злой. Он имел наглость назвать нас читерами. Да плевать, главное, что мы победили.
			Eridani: Ямата сбегает в ярости. Он вернётся, но сегодня мы доказали свою силу.
		}
	}

	Akuma: {
		Seen: {
			Asphodene: Огненная виверна, которая всё время зовёт нас «дитя». Груб и смертоносен. Типично.
			Eridani: Акума, Драконический Демон. Лобовая атака или ничего. Никаких трюков.
		}

		Defeat: {
			NotExpert: {
				Asphodene: Растворился в угольках. «Возвращайся, когда станешь лучше прежнего себя.» А ты скромен.
				Eridani: Душа Акумы осталась. Драконический Демон не умер по-настоящему - просто рассеялся.
			}

			Expert: {
				Asphodene: Он растворяется... Мы победили? Стоп, что-то происходит...
				Eridani: Форма Акумы рассеивается, но сущность задержалась. Нет, погоди... Я чувствую нарастающий выброс силы.
			}
		}
	}

	AkumaA: {
		Seen: {
			Asphodene: Это ещё не конец?! Виверна стала ГОРАЗДО горячее. Мы и правда раздули пламя!... Дело плохо.
			Eridani: Должно быть, это истинная, пробуждённая сила Акумы. Температура воздуха резко повышается – не стой на месте.
		}

		Defeat: {
			Asphodene: Наконец-то! Признал, что мы победили честно. На это ушло много времени.
			Eridani: Акума признаёт поражение. В его тоне слышится нотка уважения. Неохотная честь.
		}
	}

	Zero: {
		Seen: {
			Asphodene: Парящая машина с орбитальным оружием. Говорит кодами. Жутковато.
			Eridani: Зиро. Конструкт Судного Дня. Его оружие обрушит безжалостный шквал. В укрытие! Быстро!
		}

		Defeat: {
			NotExpert: {
				Asphodene: Зиро повержен. Хотя, кажется, в конце он что-то пытался сделать... Может, нам повезло, что он дал сбой.
				Eridani: Конструкт пал, но его «Протокол Судного Дня» меня тревожит. Возможно, нам повезло, что он не смог его использовать.
			}
		}
	}

	ZeroProtocol: {
		Seen: {
			Asphodene: Ого! Он только что отбросил своё физическое тело?! Этот «Протокол Судного Дня» не шутка! Мы теперь сражаемся с живым глюком.
			Eridani: Отбросил Модуль Зиро... Теперь мы сражаемся с чем-то совершенно иным. Оно стало гораздо подвижнее. Не дай поймать себя!
		}

		Defeat: {
			Asphodene: Сигнал бедствия? Кого ТАКАЯ штука может звать на помощь?! И этот зловещий разлом мне тоже не нравится...
			Eridani: Позволить этой машине отправить сигнал бедствия может оказаться катастрофой. Полагаю, хозяин Пустоты уже на горизонте.
		}
	}

	SupremeRajah: {
		Seen: {
			Asphodene: Снова этот парень?! Вот это силища! Но мы не дадим этому кролику положить нам конец.
			Eridani: Заступник Невинных. Это его истинная сила. Так легко мы не победим.

			Murderer: {
				Asphodene: Он ещё злее. Опять «маньячелло». Мы и правда напортачили, да?
				Eridani: Никакого прощения. Только месть. Он не остановится, пока не свершится правосудие.
			}
		}

		Defeat: {
			Asphodene: Он остановился? Ого, он хочет, чтобы мы заняли его место? {0}, он серьёзен.
			Eridani: Заступник передаёт свой долг нам. «Стань тем, на чьё плечо невинные возложат головы в трудный час.» Тяжкая ответственность.
		}
	}

	Shen: {
		Seen: {
			Asphodene: Это... Ямата И Акума. Вместе. Мы обречены...
			Eridani: Шэнь Доракон, Вестник Раздора. Истинное испытание наших способностей.
		}

		Defeat: {
			Expert: {
				Asphodene: Фух... Это было тяжко! Погодите... Что происходит?
				Eridani: Вестник Раздора пал. Нет, постой. Это ещё не конец, верно? Я чувствую остаточную энергию.
			}

			NotExpert: {
				Asphodene: Фух... Это было тяжко! Стоп... «истинная сила»? Хочешь сказать, это было не всё?!
				Eridani: Подумать только, это не всё, на что способен этот дракон... Мне страшно представить, что он может, если выложится на полную.
			}
		}
	}

	ShenA: {
		Seen: {
			Asphodene: Это даже не их финальная форма?! Этот парень никак не уймётся!
			Eridani: Он прав. Мы должны были это предвидеть. Испытание продолжается.
		}

		Defeat: {
			Asphodene: Их душа раскалывается! И они винят в этом друг друга. Классическая работа в команде у антогонистов.
			Eridani: Слияние Шэня Доракона разрушается. «Вновь предстанешь перед нашей яростью»... Бесконечный цикл.
		}
	}

	InfinityZero: {
		Seen: {
			Asphodene: Вот это махина... Это то, что вызвал сигнал бедствия?! И теперь он нацелился на нас. Похоже, у нас проблемы...
			Eridani: Механическая конструкция невероятной мощи. Должно быть, сюда и был отправлен сигнал бедствия... Приготовься.
		}

		Defeat: {
			Asphodene: Кто это вообще был?! «В следующий раз не буду так снисходителен»? Быть того не может, что он сильнее той механической твари, да...?
			Eridani: Нам повезло, что он так легко ушёл... Его мощь зашкаливала. «В следующий раз я буду менее снисходителен». Предупреждение на будущее.
		}
	}

	SoulOfCthulhu: {
		Seen: {
			Asphodene: Корабельный штурвал с лицом? И я слышу шёпот... «уходи»... жутко.
			Eridani: Душа Ктулху. Древняя, злобная, и теперь пробуждена. Нужно быть осторожнее.
		}

		Defeat: {
			Asphodene: Взорвался, проклиная нас. «Во имя Азатота!» ...Стоит ли волноваться?
			Eridani: Гнев Ктулху иссяк. Но его проклятие не стоит воспринимать легкомысленно. Это может быть не конец... Могут быть замешаны силы посерьёзнее.
		}
	}
}
