Healer: {
	AuroraScythe: {
		DisplayName: Коса Авроры
		Tooltip:
			'''
			Даёт 1 эссенцию души при прямом попадании
			Вращает вокруг вас косу с ледяным ожогом, кромсающую врагов
			Косы накладывают дебафф «Ледяной ожог» при контакте
			'''
	}

	CarrotFarmer: {
		DisplayName: Морковная коса
		Tooltip:
			'''
			Даёт 1 эссенцию души при прямом попадании
			Вращает вокруг вас морковную косу, кромсающую врагов
			При вращении косы выпускают морковь
			'''
	}

	DragonsClaw: {
		DisplayName: Драконий коготь
		Tooltip:
			'''
			Даёт 1 эссенцию души при прямом попадании
			Вращает вокруг вас огненную косу, кромсающую врагов
			Косы поджигают врагов при контакте
			'''
	}

	HydrasFury: {
		DisplayName: Ярость гидры
		Tooltip:
			'''
			Даёт 1 эссенцию души при прямом попадании
			Вращает вокруг вас косу бездны, кромсающую врагов
			Косы накладывают дебафф «Отравление» при контакте
			'''
	}
}
