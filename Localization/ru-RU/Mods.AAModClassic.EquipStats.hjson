	StatModifier: {
		Adlibs: {
			EverySingleClassExceptSummoner: {
				Base: На {0} {1} {2}{3}{4}
				Additive: На {0}% {1} {4} {2}{3}{5}
				Multiplicative: "{2}{3}{4} умножен на {0}%"
				Flat: На {0} {1} {4} {2}{3}
			}

			Summoner: {
				Base: "{1} {2}{3}{4} на {0}"
				Additive: На {0}% {1} {4} {2}{3}{5}
				Multiplicative: Умножает {2}{3}{4} на {0}%
				Flat: "{1} {2}{3}{4} на постоянные {0}"
			}
		}

		Increases: увеличивает
		Decreases: снижает
		Increased: увеличивает
		Decreased: снижает
		Increase: увеличивает
		Decrease: снижает
		Reduced: снижает
		More: большей
		Less: меньшей
		// Faster: faster
		// Slower: slower
		Damage: урон
		Knockback: отбрасывание
		CritSameAsDamageAdditive: " и шанс критического удара"
	}
}

