	AttackSpeed: ""
	ArmorPenetration: "{0} {1}{2}armor penetration by {3}"

	StatModifier: {
		Adlibs: {
			EverySingleClassExceptSummoner: {
				Base: "{0} {1} {2}{3}{4}"
				Additive: "{0}% {1} {2}{3}{4}{5}"
				Multiplicative: "{2}{3}{4} multiplied by {0}%"
				Flat: "{0} {1} flat {2}{3}{4}"
			}

			Summoner: {
				Base: "{1} {2}{3}{4} by {0}"
				Additive: "{1} {2}{3}{4}{5} by {0}%"
				Multiplicative: Multiplies {2}{3}{4} by {0}%
				Flat: "{1} {2}{3}{4} by a flat {0}"
			}
		}

		Increases: increases
		Decreases: decreases
		Increased: increased
		Decreased: decreased
		Damage: damage
		Knockback: knockback
		CritSameAsDamageAdditive: " & critical strike chance"
	}
}

