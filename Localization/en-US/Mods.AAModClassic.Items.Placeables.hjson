Functional: {
	ChaosCrucible: {
		DisplayName: Chaos Crucible
		Tooltip: Even chaos requires a steady hand and a gigantic forge to work with
	}

	TruePaladinsSmeltery: {
		DisplayName: True Paladin's Smeltery
		Tooltip:
			'''
			A superforge meant for only the worthiest of smiths
			Functions as most necessary crafting stations
			'''
	}

	HaphestusForge: {
		DisplayName: Hephaestus Forge
		Tooltip:
			'''
			*Slaps top of forge* 'This baby can fit so many crafting stations in it.'
			Functions as a Hellforge, Hellstone Anvil, Alchemy Table, Demon Altar, Tinkerer's Workshop, and a Table and Chair
			'''
	}

	DragonAltarSafe: {
		DisplayName: Dragon Altar
		Tooltip: ""
	}

	QuantumFusionAccelerator: {
		DisplayName: Quantum Fusion Accelerator
		Tooltip:
			'''
			Launching particles at the speed of sound
			Allows you to work with Dark Matter and Radium
			'''
	}

	RadiantArcanum: {
		DisplayName: Radiant Arcanum
		Tooltip:
			'''
			Wish upon a star
			Allows you to work with Dark Matter and Radium
			'''
	}

	BinaryReassembler: {
		DisplayName: Binary Fragmentation Reassembler
		Tooltip: Reality has never been so easy to manipulate
	}

	FurnitureDynamo: {
		DisplayName: Furniture Dynamo
		Tooltip:
			'''
			Combines all funiture-crafting stations into one block
			Now you don't have to clutter your base with 12 crafting stations!
			'''
	}

	CorruptAltar: {
		DisplayName: Demon Altar
		Tooltip: ""
	}

	CrimsonAltar: {
		DisplayName: Crimson Altar
		Tooltip: ""
	}

	HallowedAnvil: {
		DisplayName: Hallowed Anvil
		Tooltip: A Holy Anvil
	}

	HallowedForge: {
		DisplayName: Hallowed Forge
		Tooltip: It's amazing what this thing CAN'T cook
	}

	PaladinsSmeltery: {
		DisplayName: Paladin's Smeltery Forge
		Tooltip:
			'''
			This thing can make a lot of stuff
			Functions as most hardmode crafting stations + A workbench and heavy workbench
			'''
	}

	HellstoneAnvil: {
		DisplayName: Hellstone Anvil
		Tooltip: Is this thing supposed to be on fire?
