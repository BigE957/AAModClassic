Functional: {
	ChaosCrucible: {
		DisplayName: Chaos Crucible
		Tooltip: Even chaos requires a steady hand and a gigantic forge to work with
	}

	TruePaladinsSmeltery: {
		DisplayName: True Paladin's Smeltery
		Tooltip:
			'''
			A superforge meant for only the worthiest of smiths
			Functions as most necessary crafting stations
			'''
	}

	HaphestusForge: {
		DisplayName: Hephaestus Forge
		Tooltip:
			'''
			*Slaps top of forge* 'This baby can fit so many crafting stations in it.'
			Functions as a Hellforge, Hellstone Anvil, Alchemy Table, Demon Altar, Tinkerer's Workshop, and a Table and Chair
			'''
	}

