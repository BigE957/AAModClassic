	MapEntry: Doom Clock

	FlavorText: {
		PreZero:
			'''
			The clock is counting down to something...you aren't sure what though.
			The number at the moment is so high you don't even know what the number is called.
			'''
		PostZero: The Clock reads one digit: 0
	}
}

